{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Rome",
  "schedule": [
    "* 0-6 * * 1"
  ],
  "prConcurrentLimit": 10,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "minimumReleaseAge": "7 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* * 1-7 * 1"
    ]
  },
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "schedule": [
      "at any time"
    ]
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "matchManagers": [
        "composer"
      ],
      "matchDepTypes": [
        "require"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "php production dependencies"
    },
    {
      "matchManagers": [
        "composer"
      ],
      "matchDepTypes": [
        "require-dev"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "php development dependencies",
      "semanticCommitScope": "deps-dev"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "node production dependencies"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "node development dependencies",
      "semanticCommitScope": "deps-dev"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "semanticCommitScope": "ci"
    }
  ]
}
